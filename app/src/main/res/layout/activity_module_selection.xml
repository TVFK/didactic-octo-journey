<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5">

    <include
        android:id="@+id/topBar"
        layout="@layout/layout_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <include
            android:id="@+id/navigationPanel"
            layout="@layout/layout_navigation_panel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#e0e0e0" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="Выбор модуля распознавания"
                    android:textColor="#212121"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Таблица модулей -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="24dp"
                        android:layout_weight="2"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TableLayout
                                android:id="@+id/moduleTable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:stretchColumns="1">

                                <!-- Заголовок -->
                                <TableRow android:background="#fafafa">

                                    <TextView
                                        style="@style/TableHeaderCell"
                                        android:text="ID" />

                                    <TextView
                                        style="@style/TableHeaderCell"
                                        android:text="Столовая" />

                                    <TextView
                                        style="@style/TableHeaderCell"
                                        android:text="IP-адрес" />

                                    <TextView
                                        style="@style/TableHeaderCell"
                                        android:text="Режим" />

                                    <TextView
                                        style="@style/TableHeaderCell"
                                        android:text="Статус" />

                                    <TextView
                                        style="@style/TableHeaderCell"
                                        android:text="Версия модели" />

                                    <TextView
                                        style="@style/TableHeaderCell"
                                        android:text="Последнее соединение" />

                                </TableRow>

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="#e0e0e0" />

                            </TableLayout>
                        </HorizontalScrollView>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Информация о модуле -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="380dp"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="24dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="24dp"
                                android:text="Информация о модуле"
                                android:textColor="#212121"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <!-- ID модуля -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="ID модуля"
                                android:textColor="#9e9e9e"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvSelectedId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:text="-"
                                android:textColor="#212121"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <!-- Столовая -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="Столовая"
                                android:textColor="#9e9e9e"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvSelectedCanteen"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:text="-"
                                android:textColor="#212121"
                                android:textSize="16sp" />

                            <!-- IP-адрес -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="IP-адрес"
                                android:textColor="#9e9e9e"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvSelectedIp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:text="-"
                                android:fontFamily="monospace"
                                android:textColor="#212121"
                                android:textSize="16sp" />

                            <!-- Статус -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="Статус"
                                android:textColor="#9e9e9e"
                                android:textSize="14sp" />

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipSelectedStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-"
                                    android:textSize="12sp"
                                    app:chipIcon="@drawable/ic_circle_small"
                                    app:chipMinHeight="28dp"
                                    app:ensureMinTouchTargetSize="false" />
                            </FrameLayout>

                            <!-- Режим работы -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="Режим работы"
                                android:textColor="#9e9e9e"
                                android:textSize="14sp" />

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipSelectedMode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-"
                                    android:textSize="12sp"
                                    app:chipMinHeight="28dp"
                                    app:ensureMinTouchTargetSize="false" />
                            </FrameLayout>

                            <!-- Версия модели -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="Версия модели"
                                android:textColor="#9e9e9e"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvSelectedVersion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:text="-"
                                android:fontFamily="monospace"
                                android:textColor="#212121"
                                android:textSize="16sp" />

                            <!-- Последнее соединение -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="Последнее соединение"
                                android:textColor="#9e9e9e"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvSelectedLastConnection"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="24dp"
                                android:text="-"
                                android:textColor="#212121"
                                android:textSize="16sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGoToServer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"
                                android:text="Перейти к серверу распознавания"
                                android:textAllCaps="false"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_arrow_right"
                                app:iconGravity="end" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>