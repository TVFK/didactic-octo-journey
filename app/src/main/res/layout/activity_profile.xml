<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/themeSwitchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Темная тема"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginEnd="16dp"/>

        <Switch
            android:id="@+id/themeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/profileInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/themeSwitchContainer">

        <TextView
            android:id="@+id/tvFirstName"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/textview_border"
            android:padding="10sp"
            android:textSize="18sp"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/first_name_label" />

        <TextView
            android:id="@+id/tvLastName"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/textview_border"
            android:padding="10sp"
            android:textSize="18sp"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/last_name_label" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:background="@drawable/textview_border"
            android:padding="10sp"
            android:textSize="18sp"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/email_label" />
    </LinearLayout>

    <Button
        android:id="@+id/btnToQuestions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/to_questions_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profileInfoContainer" />

    <TextView
        android:id="@+id/tvStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="?android:attr/textColorPrimary"
        app:layout_constraintTop_toBottomOf="@id/btnToQuestions"
        tools:text="Изучено слов: 15\nПравильных: 12 (80.0%)" />

</androidx.constraintlayout.widget.ConstraintLayout>