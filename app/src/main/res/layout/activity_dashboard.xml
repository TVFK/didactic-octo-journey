<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5">

    <!--
        TopBar используется с showModuleInfo.
        В Kotlin: binding.topBar.moduleInfoContainer.visibility = View.VISIBLE
                  binding.topBar.tvRoleName.text = "Администратор"
    -->
    <include
        android:id="@+id/topBar"
        layout="@layout/layout_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Горизонтальная компоновка: навпанель + разделитель + контент -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <include
            android:id="@+id/navigationPanel"
            layout="@layout/layout_navigation_panel"
            android:layout_width="280dp"
            android:layout_height="match_parent" />

        <!-- Правая граница навпанели: borderRight: "1px solid #e0e0e0" -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#e0e0e0" />

        <!-- Основной контент: flex: 1 → layout_weight="1" -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:text="Панель состояния сервера управления"
                    android:textColor="#212121"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- ===== 4 карточки статистики ===== -->
                <!-- Каждая карточка: горизонтальный лейаут с иконкой и текстом рядом -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:orientation="horizontal">

                    <!-- Активных блюд -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#e3f2fd"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="16dp"
                                android:contentDescription="База данных"
                                android:src="@drawable/ic_database"
                                app:tint="#1976d2" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    android:text="Активных блюд"
                                    android:textColor="#9e9e9e"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvActiveDishes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="328"
                                    android:textColor="#1976d2"
                                    android:textSize="32sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Модулей онлайн -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#e8f5e9"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="16dp"
                                android:contentDescription="Активность"
                                android:src="@drawable/ic_activity"
                                app:tint="#4caf50" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    android:text="Модулей онлайн"
                                    android:textColor="#9e9e9e"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvModulesOnline"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12"
                                    android:textColor="#4caf50"
                                    android:textSize="32sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Ошибок синхронизации -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#fff3e0"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="16dp"
                                android:contentDescription="Ошибки"
                                android:src="@drawable/ic_alert_circle"
                                app:tint="#ff9800" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    android:text="Ошибок синхронизации"
                                    android:textColor="#9e9e9e"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvSyncErrors"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3"
                                    android:textColor="#ff9800"
                                    android:textSize="32sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Версия алгоритма -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#f3e5f5"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="16dp"
                                android:contentDescription="Процессор"
                                android:src="@drawable/ic_cpu"
                                app:tint="#9c27b0" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    android:text="Версия алгоритма"
                                    android:textColor="#9e9e9e"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvAlgorithmVersion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:text="v3.1.0"
                                    android:textColor="#9c27b0"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- ===== Нижний ряд: события (flex:2) + статус системы (flex:1) ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Карточка событий: flex:2 → weight=2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:layout_weight="2"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="32dp">

                            <!-- Заголовок с иконкой Clock справа -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="24dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Последние события"
                                    android:textColor="#212121"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:contentDescription="Время"
                                    android:src="@drawable/ic_access_time"
                                    app:tint="#666666" />

                            </LinearLayout>

                            <!--
                                Список событий: мок-данные захардкожены.
                                Точки переиспользуют ic_circle_small с разным tint.
                            -->

                            <!-- Событие 1: success #4caf50 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_event_row"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:text="14:23"
                                    android:textColor="#666666"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginEnd="16dp"
                                    android:src="@drawable/ic_circle_small"
                                    app:tint="#4caf50" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="MODULE-101: Успешная синхронизация меню"
                                    android:textColor="#424242"
                                    android:textSize="15sp" />

                            </LinearLayout>

                            <!-- Событие 2: warning #ff9800 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_event_row"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:text="14:15"
                                    android:textColor="#666666"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginEnd="16dp"
                                    android:src="@drawable/ic_circle_small"
                                    app:tint="#ff9800" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="MODULE-103: Модуль перешёл в режим офлайн"
                                    android:textColor="#424242"
                                    android:textSize="15sp" />

                            </LinearLayout>

                            <!-- Событие 3: success #4caf50 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_event_row"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:text="13:58"
                                    android:textColor="#666666"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginEnd="16dp"
                                    android:src="@drawable/ic_circle_small"
                                    app:tint="#4caf50" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Обновление алгоритма classifier-v3.1.0 завершено"
                                    android:textColor="#424242"
                                    android:textSize="15sp" />

                            </LinearLayout>

                            <!-- Событие 4: info #1976d2 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_event_row"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:text="13:45"
                                    android:textColor="#666666"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginEnd="16dp"
                                    android:src="@drawable/ic_circle_small"
                                    app:tint="#1976d2" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="MODULE-104: Зарегистрировано 45 новых блюд"
                                    android:textColor="#424242"
                                    android:textSize="15sp" />

                            </LinearLayout>

                            <!-- Событие 5: error #f44336 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_event_row"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:text="13:30"
                                    android:textColor="#666666"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginEnd="16dp"
                                    android:src="@drawable/ic_circle_small"
                                    app:tint="#f44336" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="MODULE-102: Ошибка синхронизации с базой данных"
                                    android:textColor="#424242"
                                    android:textSize="15sp" />

                            </LinearLayout>

                            <!-- Событие 6: success #4caf50 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_event_row"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="60dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:text="13:12"
                                    android:textColor="#666666"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_marginEnd="16dp"
                                    android:src="@drawable/ic_circle_small"
                                    app:tint="#4caf50" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Резервное копирование базы данных выполнено"
                                    android:textColor="#424242"
                                    android:textSize="15sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Карточка состояния системы: flex:1 → weight=1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="32dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="24dp"
                                android:text="Состояние системы"
                                android:textColor="#212121"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <!-- Статус 1: База данных — online -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:background="@drawable/bg_status_online"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="12dp"
                                    android:contentDescription="База данных"
                                    android:src="@drawable/ic_database"
                                    app:tint="#4caf50" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="База данных"
                                    android:textColor="#212121"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:contentDescription="Онлайн"
                                    android:src="@drawable/ic_check_circle"
                                    app:tint="#4caf50" />

                            </LinearLayout>

                            <!-- Статус 2: API сервер — online -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:background="@drawable/bg_status_online"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="12dp"
                                    android:contentDescription="API сервер"
                                    android:src="@drawable/ic_wifi"
                                    app:tint="#4caf50" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="API сервер"
                                    android:textColor="#212121"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:contentDescription="Онлайн"
                                    android:src="@drawable/ic_check_circle"
                                    app:tint="#4caf50" />

                            </LinearLayout>

                            <!-- Статус 3: Синхронизация меню — online -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:background="@drawable/bg_status_online"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="12dp"
                                    android:contentDescription="Синхронизация"
                                    android:src="@drawable/ic_activity"
                                    app:tint="#4caf50" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Синхронизация меню"
                                    android:textColor="#212121"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:contentDescription="Онлайн"
                                    android:src="@drawable/ic_check_circle"
                                    app:tint="#4caf50" />

                            </LinearLayout>

                            <!-- Статус 4: Хранилище фото — warning -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="24dp"
                                android:background="@drawable/bg_status_warning"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="16dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginEnd="12dp"
                                    android:contentDescription="Хранилище"
                                    android:src="@drawable/ic_hard_drive"
                                    app:tint="#ff9800" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Хранилище фото"
                                    android:textColor="#212121"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:contentDescription="Предупреждение"
                                    android:src="@drawable/ic_alert_circle"
                                    app:tint="#ff9800" />

                            </LinearLayout>

                            <!-- Разделитель -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginBottom="24dp"
                                android:background="#e0e0e0" />

                            <!-- Прогресс-бар хранилища: 76% -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="Использование хранилища"
                                android:textColor="#9e9e9e"
                                android:textSize="13sp" />

                            <!-- Прогресс через веса: 76 + 24 = 100 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="8dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_progress_track"
                                android:orientation="horizontal"
                                android:weightSum="100">

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="76"
                                    android:background="#ff9800" />

                                <View
