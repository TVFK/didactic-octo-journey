<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5">

    <!--
        TopBar используется с showModuleInfo.
        В Kotlin: binding.topBar.moduleInfoContainer.visibility = View.VISIBLE
                  binding.topBar.tvRoleName.text = "Администратор"
    -->
    <include
        android:id="@+id/topBar"
        layout="@layout/layout_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Горизонтальная компоновка: навпанель + разделитель + контент -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <include
            android:id="@+id/navigationPanel"
            layout="@layout/layout_navigation_panel"
            android:layout_width="280dp"
            android:layout_height="match_parent" />

        <!-- Правая граница навпанели: borderRight: "1px solid #e0e0e0" -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#e0e0e0" />

        <!-- Основной контент: заменен на FragmentContainerView для статичных панелей -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>